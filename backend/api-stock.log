      FROM "Products" AS "p"
      INNER JOIN "Categories" AS "c" ON "p"."CategoryId" = "c"."Id"
      LEFT JOIN "Brands" AS "b" ON "p"."BrandId" = "b"."Id"
      LEFT JOIN (
          SELECT "p1"."Id", "p1"."SKU", "p1"."Barcode", "p1"."Color", "p1"."Size", "p1"."PurchasePrice", "p1"."SalePrice", "p1"."CurrentStock", "p1"."MinStock", "p1"."ProductId"
          FROM "ProductVariants" AS "p1"
