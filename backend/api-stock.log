      LEFT JOIN "Vouchers" AS "v" ON "c"."Id" = "v"."CustomerId"
      LEFT JOIN (
          SELECT "t"."Id", "t"."SaleNumber", "t"."SaleDate", "t"."TotalAmount", "t"."CustomerId"
          FROM (
              SELECT "s"."Id", "s"."SaleNumber", "s"."SaleDate", "s"."TotalAmount", "s"."CustomerId", ROW_NUMBER() OVER(PARTITION BY "s"."CustomerId" ORDER BY "s"."SaleDate" DESC) AS "row"
