{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=tresor-boutique.db"
  },
  "Jwt": {
    "Issuer": "Tresor.Api",
    "Audience": "Tresor.App"
  },
  "StoreDefaults": {
    "StoreName": "Trésor Boutique",
    "PrimaryColor": "#C9A13B",
    "SecondaryColor": "#9A7420",
    "BackgroundColor": "#0B0B0B",
    "TextColor": "#FAFAFA"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "Sqlite"
  },
  "Installation": {
    "Mode": "Standalone",
    "NodeId": ""
  },
  "BackOfficeApi": {
    "BaseUrl": "",
    "TimeoutSeconds": 5,
    "IntervalSeconds": 30,
    "BatchSize": 50,
    "AllowInsecureHttp": false
  }
}
